# Version 26 (квот 2026-10-31-нд шинэчлэгдсэний дараа; энэ файлыг kaggle_overrides.env болгож хуулна).
# !!! V26-г 2026-10-31-нд хөлдөөсөн хуулбараар ажиллуулсан (эцсийн test хийгдсэн) — энэ файлыг ДАХИН БҮҮ хуул (дараагийнх:
#   kaggle_overrides_v27.env).
#   KO_UNTIL-ийг 2026-10-31 болгосон: андуурч хуулбал run_plan_l4.sh 11-01-ээс эхлэн exit 2 (хугацаа дууссан override).
#   tens/test алхам одоо ALLOW_TEST=1 тодорхой заасан үед л ажиллана (test-ийг давтан харахаас хамгаалалт). Дуусаагүй V26-г
#   үргэлжлүүлэх бол САНААТАЙГААР: KO_UNTIL-ийг шинэчилж, ALLOW_TEST=1 мөр нэмнэ (дууссан гишүүдийг input-ийн 200 мөрөөр алгасна).
# Input: t2s-v8-output-ийн V22 гаралт (madlad_m1, m1_madlad_improved_test, results/test/M1a) + V25 гаралт (rr_bge_ft,
#   bge_ft_dev.json, results/{M1rr,M1ks,M1a,M1g8,M1m} dev).
# 1) tens — ЭЦСИЙН TEST (нэг удаа): M1ks M1rr M1g8 M1m test (~4 × 1.5–2 ц) → M1r (M1a + дүрэм), M1ens, M1ensr test (загваргүй).
#    Чуулгын бүрэлдэхүүн dev-тэй ижил (суурь M1rr + M1ks M1a M1g8 M1m); дүрэм dev-ээс тогтсон.
# 2) ens pick — dev: M1ensp/M1enspr (Arctic хос харьцуулалт). Test-д PICK_TEST=1 зөвхөн dev-д M1ens-ээс ахисны дараа (V27).
KO_UNTIL=2026-10-31
STAGE=mt
MT_STEPS="tens ens pick"
MT_TENS="M1ks M1rr M1g8 M1m"
PICK_TEST=0
BEST_A=A7
# 12 ц-ийн хязгаар: mt stage эхэлснээс 660 мин; pick-ийг ≥180 мин үлдсэн үед л (timeout-тай), M1enspr хугацаа үлдвэл
MT_BUDGET_MIN=660
MT_PICK_MIN=180
