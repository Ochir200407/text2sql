# Version 29 (V28 дууссаны дараа; энэ файлыг kaggle_overrides.env болгож хуулна). ЗӨВХӨН CPU алхам (загвар ачаалахгүй) —
# урьдчилан бүртгэсэн тохиргоог dev ба test дээр НЭГ удаа (docs/ACCURACY_PLAN.md «M1ensE2r», «R7», «afx»; бүртгэл 2026-11-01,
# test-ийн дүнгээс ӨМНӨ): ense2 → M1ensE2r (M1ensE2 бүрэн бол дахин тооцохгүй), r7 → M1ens_r7, M1ensE2r_r7;
# afx → M1a_fx (суурь M1a_rs), M1ensfx, M1ensfxr, M1ensE2rfx_r7 (M1afx-ийн 4 засварыг хадгалсан raw_output-д, reselect --refix afx);
# secdb — DB-ийн шинэ REVOKE (ts_stat, ts_rewrite, *_to_xml) bot role-д үйлчилж буйг шалгана (scripts/dev/db_revoke_check.py).
# Notebook GPU шаарддаг тул T4×2 сесс (~0.7 ц: bootstrap ~13 мин + reselect). Квот: V28-ийн дараа энэ долоо хоногт ~3.5 ц.
# Input: (1) кодын dataset text2sql v36 (pack_code.py --slim; reselect --trunc-date/--refix, run_plan r7/afx, restore_keep_files-ийн засвартай);
#   (2) t2s-adapter-d2; (3) ЗӨВХӨН V28-ийн notebook Output (test-ийн E2/I3t/M1-ийн гишүүд ба V28-ийн M1ensE2 бүгд архивт).
# Шийдвэр/тайлан: python scripts/ingest/ingest_results.py --src <V29 Output> --tag V27 --out docs/RESULTS_V29.md
#   --pair M1ens:M1ens_r7 --pair M1ensr:M1ensE2r --pair M1ensE2r:M1ensE2r_r7 --pair M1a_rs:M1a_fx --pair M1ens:M1ensfx
#   --pair M1ensr:M1ensfxr --pair M1ensE2r:M1ensE2rfx_r7 (dev ба test; хоёрдогч, урьдчилан бүртгэсэн)
#   + ижил кодын ихэр суурь (afx алхам, кодын шилжилтийн шалгалт): --pair M1ens_rs:M1ensfx --pair M1ensr_rs:M1ensfxr
#   --pair M1ens:M1ens_rs --pair M1ensr:M1ensr_rs
KO_UNTIL=2026-11-21
STAGE=mt
MT_STEPS="secdb ense2 r7 afx"
ALLOW_TEST=1
BEST_A=A7
MT_BUDGET_MIN=90
